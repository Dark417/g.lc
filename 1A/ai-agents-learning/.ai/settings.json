{
  "model": "claude-sonnet-4-6",
  "env": {
    "TZ": "UTC"
  },
  "permissions": {
    "allow": [
      "Read(./**)",
      "Bash(npm test*)",
      "Bash(npm run lint*)",
      "mcp__github__list_issues",
      "mcp__github__pull_request_read"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "command": ".ai/hooks/pre-bash.sh" }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write", "command": ".ai/hooks/format.sh" }
    ]
  }
}
